{
  "manifest_version": 3,
  "name": "Civitai Image & Video Tag Search",
  "version": "1.2.0",
  "minimum_chrome_version": "109",
  "description": "Search SFW and NSFW image tags, suggest alternatives, and open filtered Civitai image or video galleries.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "host_permissions": ["https://civitai.com/*", "https://civitai.red/*"],
  "action": {
    "default_title": "Search Civitai image tags",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://civitai.com/*", "https://civitai.red/*"],
    "js": ["tag-bridge.js"],
    "run_at": "document_idle"
  }]
}
